# Server
HTTP_ADDR=:8080
# Supabase Postgres connection string (Dashboard → Connect). This is required by
# the Go API and is separate from the project URL/API keys.
DATABASE_URL=postgresql://postgres:password@localhost:5432/scholarbuddy?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# The publishable key is for the frontend's Google OAuth flow. Never expose the
# secret key in a frontend. This API validates OAuth access tokens via JWKS.
# The secret key is reserved for any future server-to-Supabase API calls; it is
# not needed by the current direct-Postgres implementation.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Internal admin-session signing secret (generate a long random value).
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
