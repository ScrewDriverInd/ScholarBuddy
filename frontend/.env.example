# ── ScholarBuddy Frontend Environment ──────────────
# Copy this file to .env.local and fill in your values.
# Vite exposes variables prefixed with VITE_ to the client.

# Backend API base URL (no trailing slash)
# Examples:
#   http://localhost:3000
#   https://api.scholarbuddy.example.com
VITE_API_BASE=http://localhost:3000

# Set to "true" to use built-in mock data instead of hitting the backend
VITE_USE_MOCK=true
